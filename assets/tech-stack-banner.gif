<svg viewBox="0 0 1200 640" xmlns="http://www.w3.org/2000/svg" font-family="Consolas, 'Courier New', monospace" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
<defs>
  <pattern id="grid" width="28" height="28" patternUnits="userSpaceOnUse">
    <path d="M 28 0 L 0 0 0 28" fill="none" stroke="#0d1a14" stroke-width="1"/>
  </pattern>
  <linearGradient id="barGlow" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0%" stop-color="#22ff88" stop-opacity="0"/>
    <stop offset="50%" stop-color="#22ff88" stop-opacity="1"/>
    <stop offset="100%" stop-color="#22ff88" stop-opacity="0"/>
  </linearGradient>
  <style>
    .badge { fill: none; stroke: #0f5c3a; stroke-width: 1.2; }
    .badge-text { fill: #22ff88; font-size: 12px; font-weight: 700; text-anchor: middle; letter-spacing: 0.5px; }
    .panel-border { fill: #050a08; stroke: #1a3d2c; stroke-width: 1.2; }
    .num { fill: #22ff88; font-size: 12px; font-weight: 700; letter-spacing: 3px; }
    .title { fill: #c8ffe4; font-size: 27px; font-weight: 800; letter-spacing: 1px; }
    .subtitle { fill: #5a8a72; font-size: 11px; letter-spacing: 1px; }
    .section-label { fill: #22ff88; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
    .list-text { fill: #9fe8c4; font-size: 12.5px; }
    .status-label { fill: #22ff88; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
    .status-text { fill: #c8ffe4; font-size: 14px; font-weight: 700; letter-spacing: 0.5px; }
    .header-title { fill: #22ff88; font-size: 13px; font-weight: 700; letter-spacing: 5px; text-anchor: middle; }
    .footer-text { fill: #5a8a72; font-size: 10.5px; letter-spacing: 2px; text-anchor: middle; }
  </style>
</defs>

